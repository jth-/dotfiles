#!/usr/bin/env zsh
# senatus — The Senate Convenes
# Orchestrates a full cmux workspace with three panes:
#   1. Claude agent (inside Docker container)
#   2. Container shell (for dev server, tests, etc.)
#   3. Host shell (for git operations)
#
# Usage: senatus [ISSUE-ID | --name NAME] [--no-claude]

set -euo pipefail

SPQR_LIB="${${0:A}:h}/../lib"
source "$SPQR_LIB/spqr.sh"

# ── Parse Arguments ───────────────────────────────────────────────
local issue_id="" adhoc_name="" no_claude=false passthrough_args=()

for arg in "$@"; do
  case "$arg" in
    --name=*)    adhoc_name="${arg#--name=}" ;;
    --no-claude) no_claude=true; passthrough_args+=("$arg") ;;
    --no-link-deps) passthrough_args+=("$arg") ;;
    -*)          perfidia "Unknown flag: $arg"; exit 1 ;;
    *)
      if [[ -z "$issue_id" ]]; then
        issue_id="$arg"
      else
        perfidia "Unexpected argument: $arg"; exit 1
      fi
      ;;
  esac
done

if ! command -v cmux &>/dev/null; then
  perfidia "cmux is required for senatus. Install it or use consul directly."
  exit 1
fi

# ── Interactive Selection (no arguments) ──────────────────────────
if [[ -z "$issue_id" && -z "$adhoc_name" ]] && spqr_require_fzf; then
  spqr_banner "SENATVS — Select a Decree"

  local fzf_input=""
  local has_linear=false

  if [[ -n "${LINEAR_API_KEY:-}" ]]; then
    nota "Fetching your assigned issues..."
    fzf_input="$(spqr_linear_my_issues 2>/dev/null)" && has_linear=true || true
  fi

  # Prepend the ad-hoc sentinel
  fzf_input="[AD-HOC]$(printf '\t')━$(printf '\t')Create new ad-hoc workspace
${fzf_input}"

  local fzf_args=(
    --header=$'SENATVS \u2014 Select a decree  \u2502  Ctrl-S: search all  \u2502  Ctrl-A: my issues  \u2502  Esc: cancel'
    --prompt="My Issues \u25b8 "
    --delimiter=$'\t'
    --with-nth=1,2,3
    --no-multi
    --ansi
    --preview-window=right:50%:wrap
    --preview="source $SPQR_LIB/spqr.sh --fn spqr_linear_issue_preview {1}"
    --bind="ctrl-s:reload(source $SPQR_LIB/spqr.sh --fn spqr_linear_search {q})+change-prompt(Search \u25b8 )"
    --bind="ctrl-a:reload(source $SPQR_LIB/spqr.sh --fn spqr_linear_my_issues)+change-prompt(My Issues \u25b8 )"
    ${(z)$(spqr_fzf_theme)}
  )

  local selection
  selection="$(printf "%s" "$fzf_input" | fzf "${fzf_args[@]}")" || {
    nota "Selection cancelled"
    exit 0
  }

  local selected_id="${selection%%$'\t'*}"

  if [[ "$selected_id" == "[AD-HOC]" ]]; then
    printf "${SPQR_GOLD}${SPQR_BOLD}  Name your session: ${SPQR_RESET}"
    read -r adhoc_name
    if [[ -z "$adhoc_name" ]]; then
      nota "No name given — using timestamp"
    fi
  else
    issue_id="$selected_id"
  fi
fi

# ── Ad Hoc Session (no issue ID) ────────────────────────────────
if [[ -z "$issue_id" ]]; then
  local branch_name
  if [[ -n "$adhoc_name" ]]; then
    branch_name="$(spqr_slugify "$adhoc_name")"
  else
    branch_name="adhoc/$(date +%Y%m%d-%H%M%S)"
  fi
  local ws_title="SPQR:${branch_name}"

  spqr_banner "SENATVS — Ad Hoc Session"

  local repo
  repo="$(spqr_detect_repo)" || exit 1

  # Check for existing workspace
  local existing_ws
  existing_ws="$(spqr_find_workspace "$ws_title")"
  if [[ -n "$existing_ws" ]]; then
    caveat "Existing session found: $ws_title"
    cmux select-workspace --workspace "$existing_ws"
    triumphus "Resumed session $ws_title"
    exit 0
  fi

  local worktree
  worktree="$(spqr_create_worktree "$repo" "$branch_name")" || exit 1
  spqr_link_deps "$repo" "$worktree"

  # Start container
  spqr_ensure_infra
  spqr_ensure_image
  local image
  image="$(spqr_ensure_project_image "$repo" "$(basename "$repo")")"
  local container_name
  container_name="$(spqr_start_container "$branch_name" "$worktree" "$image")" || exit 1
  spqr_register_site "$branch_name"

  edictum "Creating workspace..."
  local ws_id
  ws_id="$(spqr_create_workspace "$repo" "$ws_title")" || exit 1

  # Main pane: Claude in container
  local claude_cmd="docker exec -it $container_name claude --dangerously-skip-permissions"
  spqr_send "$ws_id" "" "$claude_cmd"

  # Container shell pane (for dev server, tests)
  local surface_ref_container
  surface_ref_container="$(spqr_add_split "$ws_id" right)" || true
  if [[ -n "$surface_ref_container" ]]; then
    spqr_send "$ws_id" "$surface_ref_container" "docker exec -it $container_name /bin/bash"
  fi

  # Host shell pane (for git)
  local surface_ref_host
  surface_ref_host="$(spqr_add_split "$ws_id" down)" || true
  if [[ -n "$surface_ref_host" ]]; then
    spqr_send "$ws_id" "$surface_ref_host" "cd $worktree && exec \$SHELL -l"
  fi

  cmux select-workspace --workspace "$ws_id"
  cmux set-status spqr "Ad hoc: $branch_name" --icon sparkle --color "#FFD700" --workspace "$ws_id" 2>/dev/null || true
  triumphus "Ad hoc session ready: $branch_name"
  nota "Container: $container_name"
  nota "Preview: http://${branch_name//[^a-zA-Z0-9_-]/-}.localhost:4000"
  exit 0
fi

# ── Issue-based Session ──────────────────────────────────────────
issue_id="${(U)issue_id}"

spqr_banner "SENATVS — The Senate Convenes"

# ── Query Linear for branch name ─────────────────────────────────
local branch_name=""
local linear_json
linear_json="$(spqr_query_linear "$issue_id" 2>/dev/null)" && {
  branch_name="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
print(issue.get('branchName', '') or '')
" <<< "$linear_json")"
}

if [[ -z "$branch_name" ]]; then
  branch_name="${(L)issue_id}"
fi

local ws_title="SPQR:${branch_name}"
local branch_safe="${branch_name//[^a-zA-Z0-9_-]/_}"

# ── Check for Existing Workspace ─────────────────────────────────
local existing_ws
existing_ws="$(spqr_find_workspace "$ws_title")"

if [[ -n "$existing_ws" ]]; then
  caveat "Existing session found: $ws_title"
  nota "Switching to existing workspace..."
  cmux select-workspace --workspace "$existing_ws"
  triumphus "Resumed session $ws_title"
  exit 0
fi

# ── Detect repo ──────────────────────────────────────────────────
local repo
repo="$(spqr_detect_repo)" || exit 1

# ── Ritus I: Convening the Senate ─────────────────────────────────
edictum "Ritus I: Convening the Senate"
nota "Creating workspace $ws_title..."

local ws_id
ws_id="$(spqr_create_workspace "$repo" "$ws_title")" || exit 1
nota "Workspace: $ws_id"

# ── Ritus II: Dispatching the Consul ──────────────────────────────
edictum "Ritus II: Dispatching the Consul"

# Resolve the real path of consul (it may be a symlink in ~/bin/)
local consul_path="${${0:A}:h}/consul"
local consul_cmd="$consul_path $issue_id ${passthrough_args[*]}"

nota "Running: consul $issue_id ${passthrough_args[*]}"
spqr_send "$ws_id" "" "$consul_cmd"

# ── Ritus III: The Auxiliary Camp ─────────────────────────────────
edictum "Ritus III: The Auxiliary Camp"
nota "Creating auxiliary panes..."

local container_name
container_name="$(spqr_container_name "$branch_name")"

# Container shell pane (for dev server, tests — waits for container)
local surface_ref_container
surface_ref_container="$(spqr_add_split "$ws_id" right)" || {
  caveat "Could not create container shell split — continuing with fewer panes"
}

if [[ -n "$surface_ref_container" ]]; then
  local worktree_dir="$repo/.worktrees/$branch_name"
  # Write a helper that waits for the plan, then opens a container shell
  local wait_script="$repo/.worktrees/.senatus-wait-${branch_safe}.sh"
  mkdir -p "$repo/.worktrees"
  cat > "$wait_script" <<WAITEOF
#!/usr/bin/env zsh
echo 'Awaiting Acta Senatus...'
cmux wait-for ACTA_READY_${branch_safe} --timeout 300 2>/dev/null
echo 'Container shell ready — use this for dev server, tests, etc.'
exec docker exec -it ${container_name} /bin/bash
WAITEOF
  chmod +x "$wait_script"
  spqr_send "$ws_id" "$surface_ref_container" "source $wait_script"
fi

# Host shell pane (for git operations)
local surface_ref_host
surface_ref_host="$(spqr_add_split "$ws_id" down)" || {
  caveat "Could not create host shell split"
}

if [[ -n "$surface_ref_host" ]]; then
  local worktree_dir="$repo/.worktrees/$branch_name"
  local host_wait_script="$repo/.worktrees/.senatus-host-${branch_safe}.sh"
  cat > "$host_wait_script" <<WAITEOF
#!/usr/bin/env zsh
echo 'Awaiting Acta Senatus...'
cmux wait-for ACTA_READY_${branch_safe} --timeout 300 2>/dev/null
cd "$worktree_dir" 2>/dev/null && echo "Git shell ready in worktree: $branch_name"
exec \$SHELL -l
WAITEOF
  chmod +x "$host_wait_script"
  spqr_send "$ws_id" "$surface_ref_host" "source $host_wait_script"
fi

# ── Switch to workspace ──────────────────────────────────────────
cmux select-workspace --workspace "$ws_id"

# Set sidebar status
cmux set-status spqr "Senatus in session" --icon sparkle --color "#FFD700" --workspace "$ws_id" 2>/dev/null || true

triumphus "The Senate is convened for $issue_id"
nota "Preview: http://${branch_name//[^a-zA-Z0-9_-]/-}.localhost:4000"
