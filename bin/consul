#!/usr/bin/env zsh
# consul — The Campaign Planner
# Fetches a Linear issue, creates a worktree, generates an implementation plan,
# and launches an interactive Claude session.
#
# Usage: consul <ISSUE-ID> [--no-claude] [--no-link-deps]

set -euo pipefail

# Resolve the real script dir (works through symlinks)
SPQR_LIB="${${0:A}:h}/../lib"
source "$SPQR_LIB/spqr.sh"

# ── Parse Arguments ───────────────────────────────────────────────
local issue_id="" no_claude=false no_link_deps=false

for arg in "$@"; do
  case "$arg" in
    --no-claude)    no_claude=true ;;
    --no-link-deps) no_link_deps=true ;;
    -*)             perfidia "Unknown flag: $arg"; exit 1 ;;
    *)
      if [[ -z "$issue_id" ]]; then
        issue_id="$arg"
      else
        perfidia "Unexpected argument: $arg"; exit 1
      fi
      ;;
  esac
done

if [[ -z "$issue_id" ]]; then
  perfidia "Usage: consul <ISSUE-ID> [--no-claude] [--no-link-deps]"
  exit 1
fi

# Uppercase the issue ID
issue_id="${(U)issue_id}"

spqr_banner "CONSVL — The Campaign Planner"

# ── Ritus I: Querying the Oracle ──────────────────────────────────
edictum "Ritus I: Querying the Oracle"
nota "Fetching decree $issue_id from Linear..."

local linear_json="" issue_title="" issue_desc="" branch_name="" parent_context="" project_context=""

linear_json="$(spqr_query_linear "$issue_id" 2>/dev/null)" && {
  issue_title="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
print(issue.get('title', ''))
" <<< "$linear_json")"

  issue_desc="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
print(issue.get('description', '') or '')
" <<< "$linear_json")"

  branch_name="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
print(issue.get('branchName', '') or '')
" <<< "$linear_json")"

  parent_context="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
parent = issue.get('parent') or {}
if parent:
    print(f\"{parent.get('identifier', '')}: {parent.get('title', '')}\")
    desc = parent.get('description', '') or ''
    if desc:
        print(desc[:500])
" <<< "$linear_json")"

  project_context="$(python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
issue = data.get('data', {}).get('issue', {})
proj = issue.get('project') or {}
if proj:
    print(f\"Project: {proj.get('name', '')}\")
    desc = proj.get('description', '') or ''
    if desc:
        print(desc[:500])
" <<< "$linear_json")"

  if [[ -n "$issue_title" ]]; then
    triumphus "Found: $issue_id — $issue_title"
  fi
} || {
  caveat "Could not fetch from Linear — Claude will look up the issue via MCP"
}

# Derive branch name: prefer Linear's, fall back to lowercase issue ID
if [[ -z "$branch_name" ]]; then
  branch_name="${(L)issue_id}"
fi
nota "Branch: $branch_name"

# ── Ritus II: Establishing the Castra ─────────────────────────────
edictum "Ritus II: Establishing the Castra"

local repo
repo="$(spqr_detect_repo)" || exit 1
nota "Repo: $repo"

local worktree
worktree="$(spqr_create_worktree "$repo" "$branch_name")" || exit 1
nota "Worktree: $worktree"

if [[ "$no_link_deps" == false ]]; then
  spqr_link_deps "$repo" "$worktree"
  nota "Dependencies linked"
fi

# ── Build Issue Context ───────────────────────────────────────────
local issue_context="Linear Issue: $issue_id"
[[ -n "$issue_title" ]] && issue_context+="\nTitle: $issue_title"
[[ -n "$issue_desc" ]]  && issue_context+="\n\nDescription:\n$issue_desc"
[[ -n "$parent_context" ]] && issue_context+="\n\nParent Issue:\n$parent_context"
[[ -n "$project_context" ]] && issue_context+="\n\n$project_context"

# ── Ritus III: Drafting the Acta Senatus ──────────────────────────
edictum "Ritus III: Drafting the Acta Senatus"
nota "Dispatching reconnaissance Claude to draft the implementation plan..."

local plan_prompt="You are a senior engineer exploring a codebase to plan an implementation.

Issue Context:
$issue_context

Your task:
1. Explore the codebase thoroughly — read relevant files, understand the architecture
2. Write an implementation plan to a file called ACTA_SENATUS.md in the working directory

The plan MUST have these sections:
## Objective
One-paragraph summary of what we're building and why.

## Reconnaissance
What you found in the codebase — relevant files, patterns, architecture decisions.

## Battle Plan
Numbered, ordered steps for implementation. Each step should reference specific files to create or modify.

## Auxiliary Concerns
Edge cases, migration needs, backward compatibility, things to watch out for.

## Victory Conditions
How to verify the implementation is complete and correct (tests to write, manual checks, etc.)

Be specific and reference actual files/functions you found. This plan will guide an interactive coding session."

if [[ -z "$issue_title" && -z "$issue_desc" ]]; then
  # No Linear data — tell Claude to look it up
  plan_prompt="You are a senior engineer exploring a codebase to plan an implementation.

The issue ID is: $issue_id
Look up this issue using Linear MCP tools if available, otherwise ask the user for context.

Your task:
1. Look up the issue details
2. Explore the codebase thoroughly — read relevant files, understand the architecture
3. Write an implementation plan to a file called ACTA_SENATUS.md in the working directory

The plan MUST have these sections:
## Objective
One-paragraph summary of what we're building and why.

## Reconnaissance
What you found in the codebase — relevant files, patterns, architecture decisions.

## Battle Plan
Numbered, ordered steps for implementation. Each step should reference specific files to create or modify.

## Auxiliary Concerns
Edge cases, migration needs, backward compatibility, things to watch out for.

## Victory Conditions
How to verify the implementation is complete and correct (tests to write, manual checks, etc.)

Be specific and reference actual files/functions you found. This plan will guide an interactive coding session."
fi

(cd "$worktree" && claude -p --permission-mode plan "$plan_prompt" > /dev/null 2>&1)

# Signal that the plan is ready
local branch_safe="${branch_name//[^a-zA-Z0-9_-]/_}"
if command -v cmux &>/dev/null; then
  cmux wait-for -S "ACTA_READY_${branch_safe}" 2>/dev/null || true
fi

triumphus "Acta Senatus drafted at $worktree/ACTA_SENATUS.md"

# ── Ritus IV: The Consul Takes the Field ──────────────────────────
if [[ "$no_claude" == true ]]; then
  triumphus "Campaign planned. Worktree ready at: $worktree"
  echo "$worktree"
  exit 0
fi

edictum "Ritus IV: The Consul Takes the Field"
nota "Launching interactive Claude session..."

local system_prompt="You are working on Linear issue $issue_id"
[[ -n "$issue_title" ]] && system_prompt+=": $issue_title"
system_prompt+=".

An implementation plan has been drafted at ACTA_SENATUS.md — review it first.
Follow the Battle Plan steps to implement the changes.
Ask the user if anything in the plan needs adjustment before starting."
[[ -n "$issue_context" ]] && system_prompt+="\n\nIssue Context:\n$issue_context"

cd "$worktree"
exec claude --append-system-prompt "$system_prompt"
